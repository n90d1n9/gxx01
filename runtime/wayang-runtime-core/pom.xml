  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- agent-core                                                   -->
  <!-- Core agent implementation: lifecycle, coordination, and     -->
  <!-- integration points. Minimal core - domains extracted to     -->
  <!-- separate modules (agent-inference, agent-memory, etc.)      -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <artifactId>wayang-runtime-core</artifactId>
  <packaging>jar</packaging>
  <name>Wayang Runtime Core</name>
  <description>
    Core execution runtime for Wayang Agents, Workflows, and Skills.
    Provides execution engine, ReAct loop, coordination, lifecycle management,
    and bridges to the Wayang Harness governance and checkpoint substrate.
  </description>

    <properties>
        <gollek.version>0.1.0-SNAPSHOT</gollek.version>
    </properties>

  <dependencies>

    <!-- CDI annotations only (compile scope — no runtime needed in SPI jar) -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Gollek Tools SPI (for tool integration) - optional, adapter only 
    NOTE: These modules don't exist in gollek, comment out for now
    <dependency>
      <groupId>tech.kayys.gollek</groupId>
      <artifactId>gollek-tools-spi</artifactId>
      <version>${gollek.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>tech.kayys.gollek</groupId>
      <artifactId>gollek-tools-core</artifactId>
      <version>${gollek.version}</version>
      <optional>true</optional>
    </dependency>
    -->

    <!-- gollek-spi and gollek-spi-inference removed: not in local repo and not used by any source -->
    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-tool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tech.kayys.wayang</groupId>
