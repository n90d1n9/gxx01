    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-spi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-harness</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-plugin-spi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Gollek SDK facade — discovers local or remote implementation at runtime - optional -->
    <dependency>
      <groupId>tech.kayys.gollek</groupId>
      <artifactId>gollek-sdk</artifactId>
      <version>${gollek.version}</version>
      <optional>true</optional>
      <exclusions>
        <!-- These alkhawarizm artifacts are not in any reachable repo -->
        <exclusion>
          <groupId>tech.kayys.alkhawarizm</groupId>
          <artifactId>*</artifactId>
        </exclusion>
        <exclusion>
          <groupId>tech.kayys.gollek</groupId>
          <artifactId>gollek-sdk-protobuf</artifactId>
        </exclusion>
        <exclusion>
          <groupId>tech.kayys.gollek</groupId>
          <artifactId>gollek-sdk-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
