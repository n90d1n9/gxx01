    <!-- Mutiny for reactive programming -->
    <dependency>
      <groupId>io.smallrye.reactive</groupId>
      <artifactId>mutiny</artifactId>
    </dependency>

    <!-- Lombok -->

    <!-- Tool Integration -->
    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-tool-core</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>

    <!-- Git implementation for Skills Loader -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>6.8.0.202311291450-r</version>
    </dependency>

    <!-- Caffeine cache for ToolCacheManager -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <version>3.1.8</version>
    </dependency>

    <!-- Memory Integration -->
    <dependency>
      <groupId>tech.kayys.wayang</groupId>
      <artifactId>wayang-memory</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>tech.kayys.gamelan</groupId>
          <artifactId>gamelan-engine-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Embedding Integration -->
    <dependency>
